# Local Development Environment Variables
# Copy this file to .env.local and fill in your values

# Neon Database Connection
# Replace with your actual Neon connection string from the dashboard
DATABASE_URL=postgresql://user:password@db.neon.tech/database

# JWT Secret for session tokens
# Generate a new one with: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-minimum-32-characters

# Stripe Test Keys (get from Stripe Dashboard)
STRIPE_SECRET_KEY=sk_test_51234567890123456789012345678
STRIPE_WEBHOOK_SECRET=whsec_1234567890123456789012345678

# Application Settings
NODE_ENV=development
PORT=8080
